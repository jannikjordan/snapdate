<Project Sdk="Microsoft.NET.Sdk">
  <!-- Adapters for ports: metadata, file system, settings. -->
  <PropertyGroup>
    <RootNamespace>Snapdate.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Snapdate.Application\Snapdate.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MetadataExtractor" />
  </ItemGroup>
  <ItemGroup>
    <!-- Public keys that update signatures are checked against; build.ps1 -Target SignRelease verifies with the same files. -->
    <EmbeddedResource Include="Updates\Keys\*.pub.pem" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Snapdate.Infrastructure.Tests" />
  </ItemGroup>
</Project>
